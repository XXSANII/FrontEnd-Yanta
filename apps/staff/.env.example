# ที่อยู่ Backend (dev: / ผ่าน Vite proxy | production: URL เต็ม เช่น https://api.example.com)
VITE_API_URL=/
# ใช้ล็อกอินพนักงาน (Supabase Auth) และอัปโหลดรูปเมนู ใช้ publishable key เท่านั้น ห้ามใส่ secret key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# โดเมนหน้าลูกค้า ใช้สร้างลิงก์ QR
VITE_CUSTOMER_URL=http://localhost:5173
